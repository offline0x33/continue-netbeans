<filesystem>
    <!-- Menu Integration -->
    <folder name="Menu">
        <folder name="Tools">
            <file name="com-bajinho-continuebeans-ui-MenuIntegration.instance">
                <attr name="instanceCreate" methodvalue="com.bajinho.continuebeans.ui.MenuIntegration.create"/>
                <attr name="position" intvalue="1500"/>
            </file>
            <attr name="com-bajinho-continuebeans-ui-MenuIntegration.instance/Window-Debug-separatorAfter.instance" boolvalue="true"/>
        </folder>
    </folder>
    
    <!-- Window Integration -->
    <folder name="Windows2">
        <folder name="Components">
            <file name="ProfessionalContinueBeansTopComponent.settings" url="ProfessionalContinueBeansTopComponentSettings.xml"/>
        </folder>
        <folder name="Modes">
            <folder name="editor">
                <file name="ProfessionalContinueBeansTopComponent.wstcref" url="ProfessionalContinueBeansTopComponentWstcref.xml"/>
            </folder>
        </folder>
    </folder>
    
    <!-- Actions Integration -->
    <folder name="Actions">
        <folder name="Window">
            <file name="com-bajinho-continuebeans-ui-ProfessionalTopComponent.action">
                <attr name="delegate" newvalue="com.bajinho.continuebeans.ui.ProfessionalTopComponent"/>
                <attr name="displayName" bundlevalue="com.bajinho.continuebeans.ui.Bundle#CTL_ProfessionalContinueBeansAction"/>
                <attr name="iconBase" stringvalue="com/bajinho/continuebeans/ui/continue_beans_logo.png"/>
            </file>
        </folder>
    </folder>
    
    <!-- Toolbar Integration -->
    <folder name="Toolbars">
        <folder name="Build">
            <file name="com-bajinho-continuebeans-ui-ToolbarAction.instance">
                <attr name="instanceCreate" methodvalue="com.bajinho.continuebeans.ui.ToolbarAction.create"/>
                <attr name="position" intvalue="200"/>
            </file>
        </folder>
    </folder>
    
    <!-- Options Panel Integration -->
    <folder name="OptionsDialog">
        <folder name="Advanced">
            <file name="com-bajinho-continuebeans-ui-ContinueBeansOptionsPanel.instance">
                <attr name="instanceClass" stringvalue="com.bajinho.continuebeans.ui.ContinueBeansOptionsPanel"/>
                <attr name="position" intvalue="100"/>
            </file>
        </folder>
    </folder>
    
    <!-- Templates Integration -->
    <folder name="Templates">
        <folder name="Other">
            <file name="AITemplate.java" url="AITemplate.java">
                <attr name="position" intvalue="100"/>
                <attr name="displayName" bundlevalue="com.bajinho.continuebeans.ui.Bundle#TPL_AI_Template"/>
                <attr name="template" boolvalue="true"/>
            </file>
        </folder>
    </folder>
    
    <!-- MIME Types Integration -->
    <folder name="Services">
        <folder name="MIMEResolver">
            <file name="ai-context.xml" url="ai-context-mime-resolver.xml">
                <attr name="displayName" bundlevalue="com.bajinho.continuebeans.ui.Bundle#MIME_AI_Context"/>
            </file>
        </folder>
    </folder>
    
    <!-- Keyboard Shortcuts -->
    <folder name="Shortcuts">
        <file name="D-S-K.shadow">
            <attr name="originalFile" stringvalue="Actions/Window/com-bajinho-continuebeans-ui-ProfessionalTopComponent.action"/>
        </file>
    </folder>
    
    <!-- Help Integration -->
    <folder name="Services">
        <folder name="JavaHelp">
            <file name="com-bajinho-continuebeans-helpset.xml" url="helpset.xml">
                <attr name="position" intvalue="100"/>
            </file>
        </folder>
    </folder>
</filesystem>